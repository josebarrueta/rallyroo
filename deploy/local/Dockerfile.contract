# Synthetic, credential-free contract server; never a production image.
FROM node:22-bookworm-slim
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY src ./src
COPY test/support/contract-server.ts ./test/support/contract-server.ts
CMD ["npm", "run", "contract-server"]
