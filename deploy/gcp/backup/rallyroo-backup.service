[Unit]
Description=Rallyroo daily PostgreSQL custom-archive backup
After=k3s.service
Wants=k3s.service

[Service]
Type=oneshot
StateDirectory=rallyroo-backup
StateDirectoryMode=0700
ExecStart=/opt/rallyroo/backups/run-backup.sh
ExecStartPost=/usr/bin/touch /var/lib/rallyroo-backup/backup-ok
StandardOutput=journal
StandardError=journal
