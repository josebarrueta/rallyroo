{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rallyroo-deployment-alerts",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-29",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "alerts.rallyroo.dev",
      "custom_domain": true
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "BACKUP_MONITOR_STATE", "class_name": "BackupMonitorState" }]
  },
  "migrations": [{ "tag": "backup-monitor-v1", "new_sqlite_classes": ["BackupMonitorState"] }],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "secrets": {
    "required": ["FLUX_HMAC_SECRET", "RESEND_API_KEY", "ALERT_RECIPIENT"]
  }
}
